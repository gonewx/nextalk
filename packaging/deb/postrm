#!/bin/bash
# postrm - Nextalk DEB package post-removal script
# Purpose: 插件文件删除后重启 Fcitx5，使插件真正卸载（prerm 阶段文件仍在，重启会重新加载插件）

set -e

# Detect language (Chinese if LANG starts with zh)
is_chinese() {
    [[ "${LANG:-}" == zh_* ]] || [[ "${LC_ALL:-}" == zh_* ]] || [[ "${LC_MESSAGES:-}" == zh_* ]]
}

# 以原会话环境重启指定 fcitx5 进程：先停旧实例并等待其退出，再启动新实例。
# 不使用 `fcitx5 -r`：它让新旧实例短暂并存，旧版插件退出时会删掉新实例刚建好的
# socket，导致升级后只能剪贴板上屏、必须重启机器才恢复。
restart_fcitx5_pid() {
    local pid="$1" user uid home kv i
    user=$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ')
    [ -n "$user" ] || return 1
    uid=$(id -u "$user" 2>/dev/null) || return 1
    home=$(getent passwd "$user" | cut -d: -f6)

    # 继承原进程的会话环境 (WAYLAND_DISPLAY/DISPLAY/DBUS_SESSION_BUS_ADDRESS 等)
    local envs=("HOME=$home" "USER=$user" "LOGNAME=$user"
        "PATH=/usr/local/bin:/usr/bin:/bin"
        "XDG_RUNTIME_DIR=/run/user/$uid"
        "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus")
    # 兜底：原进程可能是旧版脚本用 sudo 拉起的，缺少 WAYLAND_DISPLAY
    if [ -S "/run/user/$uid/wayland-0" ]; then
        envs+=("WAYLAND_DISPLAY=wayland-0")
    fi
    while IFS= read -r -d '' kv; do
        case "$kv" in SUDO_*) ;; *) envs+=("$kv") ;; esac
    done 2>/dev/null < "/proc/$pid/environ"

    kill "$pid" 2>/dev/null || return 1
    for i in $(seq 1 50); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null
        sleep 0.2
    fi

    if command -v runuser >/dev/null 2>&1; then
        runuser -u "$user" -- env -i "${envs[@]}" fcitx5 -d </dev/null >/dev/null 2>&1
    else
        sudo -u "$user" env -i "${envs[@]}" fcitx5 -d </dev/null >/dev/null 2>&1
    fi
    echo "$user"
}

# Restart Fcitx5 for all users who have it running
restart_fcitx5() {
    local restarted=false pid user

    for pid in $(pgrep -x fcitx5 2>/dev/null); do
        if user=$(restart_fcitx5_pid "$pid"); then
            restarted=true
            if is_chinese; then
                echo "  已为用户 $user 重启 Fcitx5"
            else
                echo "  Restarted Fcitx5 for user $user"
            fi
        fi
    done

    return 0
}

case "$1" in
    remove)
        # Restart Fcitx5 to unload the plugin
        if pgrep -x "fcitx5" > /dev/null 2>&1; then
            if is_chinese; then
                echo "正在重启 Fcitx5 以卸载插件..."
            else
                echo "Restarting Fcitx5 to unload plugin..."
            fi
            restart_fcitx5
            echo ""
        fi
        ;;

    purge|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
