Name:           nextalk
Version:        {{VERSION}}
Release:        {{RELEASE}}%{?dist}
Summary:        High-performance offline voice input for Linux
Summary(zh_CN): Linux 高性能离线语音输入应用

License:        Proprietary
URL:            https://github.com/gonewx/nextalk

# Disable automatic dependency detection (we bundle our own libs)
AutoReqProv:    no

Requires:       fcitx5 >= 5.0
Requires:       gtk3 >= 3.24
Requires:       glibc >= 2.31
Requires:       libayatana-appindicator-gtk3
Requires:       tar
Requires:       bzip2
Recommends:     pulseaudio
# GNOME 桌面显示托盘图标需要此扩展(装后需启用并重登会话);KDE 原生支持 SNI 无需扩展
Recommends:     gnome-shell-extension-appindicator

%description
Nextalk is a high-performance offline voice-to-text application designed
for Linux, featuring real-time speech recognition with minimal latency.

Key Features:
- Offline speech recognition (Sherpa-onnx streaming bilingual model)
- Transparent borderless capsule floating window UI
- Text input via Fcitx5 input method framework
- GNOME Shell extension backend for ibus-based GNOME desktops (enable + re-login)
- End-to-end latency < 200ms

Supports Chinese and English bilingual voice recognition.

%description -l zh_CN
Nextalk 是一款专为 Linux 设计的高性能离线语音输入应用，
具有实时语音识别和极低延迟特性。

主要特性：
- 离线语音识别（基于 Sherpa-onnx 流式双语模型）
- 真透明无边框胶囊悬浮窗 UI
- 通过 Fcitx5 输入法框架实现文本上屏
- GNOME Shell 扩展后端支持 ibus 桌面直接上屏（启用扩展后重登生效）
- 端到端延迟 < 200ms

支持中英文双语语音识别。

%install
# Content is pre-assembled by build-pkg.sh, just copy
cp -a %{_builddir}/staging/* %{buildroot}/

# 安装/升级后的收尾放在 %posttrans：RPM 升级顺序是 新包 %post → 旧包 %preun，
# 旧版 %preun 会删除软链并重启 fcitx5，因此软链与 fcitx5 重启必须在整个事务结束后进行
%posttrans -p /bin/bash
# Create symlinks
ln -sf /opt/nextalk/nextalk /usr/bin/nextalk
ln -sf /opt/nextalk/nextalk-toggle /usr/bin/nextalk-toggle

# Detect language (Chinese if LANG starts with zh)
is_chinese() {
    case "${LANG:-}" in zh_*) return 0;; esac
    case "${LC_ALL:-}" in zh_*) return 0;; esac
    case "${LC_MESSAGES:-}" in zh_*) return 0;; esac
    return 1
}

# 以原会话环境重启指定 fcitx5 进程：先停旧实例并等待其退出，再启动新实例。
# 不使用 `fcitx5 -r`：它让新旧实例短暂并存，旧版插件退出时会删掉新实例刚建好的
# socket，导致升级后只能剪贴板上屏、必须重启机器才恢复。
restart_fcitx5_pid() {
    local pid="$1" user uid home kv i
    user=$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ')
    [ -n "$user" ] || return 1
    uid=$(id -u "$user" 2>/dev/null) || return 1
    home=$(getent passwd "$user" | cut -d: -f6)

    # 继承原进程的会话环境 (WAYLAND_DISPLAY/DISPLAY/DBUS_SESSION_BUS_ADDRESS 等)
    local envs=("HOME=$home" "USER=$user" "LOGNAME=$user"
        "PATH=/usr/local/bin:/usr/bin:/bin"
        "XDG_RUNTIME_DIR=/run/user/$uid"
        "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus")
    # 兜底：原进程可能是旧版脚本用 sudo 拉起的，缺少 WAYLAND_DISPLAY
    if [ -S "/run/user/$uid/wayland-0" ]; then
        envs+=("WAYLAND_DISPLAY=wayland-0")
    fi
    while IFS= read -r -d '' kv; do
        case "$kv" in SUDO_*) ;; *) envs+=("$kv") ;; esac
    done 2>/dev/null < "/proc/$pid/environ"

    kill "$pid" 2>/dev/null || return 1
    for i in $(seq 1 50); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null
        sleep 0.2
    fi

    if command -v runuser >/dev/null 2>&1; then
        runuser -u "$user" -- env -i "${envs[@]}" fcitx5 -d </dev/null >/dev/null 2>&1
    else
        sudo -u "$user" env -i "${envs[@]}" fcitx5 -d </dev/null >/dev/null 2>&1
    fi
    echo "$user"
}

# Restart Fcitx5 for all users
restart_fcitx5() {
    for pid in $(pgrep -x fcitx5 2>/dev/null); do
        if user=$(restart_fcitx5_pid "$pid"); then
            if is_chinese; then
                echo "  已为用户 $user 重启 Fcitx5"
            else
                echo "  Restarted Fcitx5 for user $user"
            fi
        fi
    done
}

echo ""
echo "═══════════════════════════════════════════════════════════"
if is_chinese; then
    echo "  Nextalk 安装完成！"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo "正在重启 Fcitx5..."
    restart_fcitx5
    echo ""
    echo "运行 'nextalk' 启动应用。"
    echo ""
    echo "🖥️  GNOME (ibus) 桌面（如 Fedora 默认会话，未运行 fcitx5）："
    echo "   需启用扩展并重新登录才能直接上屏，否则退回剪贴板模式："
    echo "   gnome-extensions enable nextalk@gonewx.com"
    echo "   （扩展仅对 Wayland 原生窗口生效；X11/XWayland 应用自动退回剪贴板）"
    echo ""
    echo "💡 温馨提示："
    echo "   如果遇到问题，请尝试重新登录或重启系统。"
else
    echo "  Nextalk Installation Complete!"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo "Restarting Fcitx5..."
    restart_fcitx5
    echo ""
    echo "Run 'nextalk' to start the application."
    echo ""
    echo "🖥️  GNOME (ibus) desktops (e.g. Fedora default session, no fcitx5 running):"
    echo "   Enable the extension and re-login for direct text injection"
    echo "   (falls back to clipboard mode otherwise):"
    echo "   gnome-extensions enable nextalk@gonewx.com"
    echo "   (Wayland-native windows only; X11/XWayland apps fall back to clipboard)"
    echo ""
    echo "💡 Tip:"
    echo "   If you encounter issues, try logging out and back in, or restart your system."
fi
echo ""

%preun -p /bin/bash
# 升级时 ($1 >= 1) 不清理软链、不重启 fcitx5，由新包 %posttrans 统一处理
if [ "$1" -ge 1 ]; then
    exit 0
fi

# Clean symlinks
rm -f /usr/bin/nextalk /usr/bin/nextalk-toggle

# Detect language (Chinese if LANG starts with zh)
is_chinese() {
    case "${LANG:-}" in zh_*) return 0;; esac
    case "${LC_ALL:-}" in zh_*) return 0;; esac
    case "${LC_MESSAGES:-}" in zh_*) return 0;; esac
    return 1
}

echo ""
echo "═══════════════════════════════════════════════════════════"
if is_chinese; then
    echo "  正在卸载 Nextalk..."
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo "注意: 您的用户数据将被保留在以下位置："
    echo "  ~/.local/share/nextalk/"
    echo ""
    echo "如需完全清理，请手动删除上述目录。"
else
    echo "  Uninstalling Nextalk..."
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo "Note: Your user data will be preserved at:"
    echo "  ~/.local/share/nextalk/"
    echo ""
    echo "To completely remove all data, manually delete the above directory."
fi
echo ""


%postun -p /bin/bash
# 仅在卸载 ($1 == 0) 时、插件文件已删除后重启 Fcitx5，使插件真正卸载
if [ "$1" -ne 0 ]; then
    exit 0
fi

# Detect language (Chinese if LANG starts with zh)
is_chinese() {
    case "${LANG:-}" in zh_*) return 0;; esac
    case "${LC_ALL:-}" in zh_*) return 0;; esac
    case "${LC_MESSAGES:-}" in zh_*) return 0;; esac
    return 1
}

# Restart Fcitx5 to unload plugin
if pgrep -x "fcitx5" > /dev/null 2>&1; then
    if is_chinese; then
        echo "正在重启 Fcitx5 以卸载插件..."
    else
        echo "Restarting Fcitx5 to unload plugin..."
    fi
    # 以原会话环境重启指定 fcitx5 进程：先停旧实例并等待其退出，再启动新实例。
    # 不使用 `fcitx5 -r`：它让新旧实例短暂并存，旧版插件退出时会删掉新实例刚建好的
    # socket，导致升级后只能剪贴板上屏、必须重启机器才恢复。
    restart_fcitx5_pid() {
        local pid="$1" user uid home kv i
        user=$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ')
        [ -n "$user" ] || return 1
        uid=$(id -u "$user" 2>/dev/null) || return 1
        home=$(getent passwd "$user" | cut -d: -f6)

        # 继承原进程的会话环境 (WAYLAND_DISPLAY/DISPLAY/DBUS_SESSION_BUS_ADDRESS 等)
        local envs=("HOME=$home" "USER=$user" "LOGNAME=$user"
            "PATH=/usr/local/bin:/usr/bin:/bin"
            "XDG_RUNTIME_DIR=/run/user/$uid"
            "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus")
        # 兜底：原进程可能是旧版脚本用 sudo 拉起的，缺少 WAYLAND_DISPLAY
        if [ -S "/run/user/$uid/wayland-0" ]; then
            envs+=("WAYLAND_DISPLAY=wayland-0")
        fi
        while IFS= read -r -d '' kv; do
            case "$kv" in SUDO_*) ;; *) envs+=("$kv") ;; esac
        done 2>/dev/null < "/proc/$pid/environ"

        kill "$pid" 2>/dev/null || return 1
        for i in $(seq 1 50); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.1
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null
            sleep 0.2
        fi

        if command -v runuser >/dev/null 2>&1; then
            runuser -u "$user" -- env -i "${envs[@]}" fcitx5 -d </dev/null >/dev/null 2>&1
        else
            sudo -u "$user" env -i "${envs[@]}" fcitx5 -d </dev/null >/dev/null 2>&1
        fi
        echo "$user"
    }
    for pid in $(pgrep -x fcitx5 2>/dev/null); do
        restart_fcitx5_pid "$pid" >/dev/null || true
    done
    echo ""
fi

